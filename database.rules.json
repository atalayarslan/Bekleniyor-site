{
  "rules": {
    "odalar": {
      ".read": true,
      "$oda": {
        ".write": "auth != null && ((root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com')) || (!root.child('yasakli').child(auth.uid).exists() && (data.child('bilgi/sahip').val() == auth.uid || (!data.child('bilgi').exists() && $oda != 'ana'))))",
        "bilgi": {
          ".validate": "newData.hasChildren(['ad', 'sahip', 'olusturma', 'herkeseAcik']) && ((data.exists() && newData.child('sahip').val() == data.child('sahip').val()) || (!data.exists() && newData.child('sahip').val() == auth.uid)) && ((root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com')) || ($oda != 'ana' && (newData.parent().parent().parent().child('kullanicilar').child(newData.child('sahip').val()).child('slot1').val() == $oda || newData.parent().parent().parent().child('kullanicilar').child(newData.child('sahip').val()).child('slot2').val() == $oda)))",
          "ad": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "sahip": {
            ".validate": "newData.isString()"
          },
          "sahipAdi": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "olusturma": {
            ".validate": "newData.isNumber()"
          },
          "herkeseAcik": {
            ".validate": "newData.isBoolean()"
          },
          "$diger": {
            ".validate": false
          }
        },
        "tasarim": {
          ".validate": "newData.parent().child('bilgi').exists() || $oda == 'ana'",
          "tema": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "arka1": {
            ".validate": "newData.isString() && newData.val().length == 7 && newData.val().beginsWith('#')"
          },
          "arka2": {
            ".validate": "newData.isString() && newData.val().length == 7 && newData.val().beginsWith('#')"
          },
          "vurgu": {
            ".validate": "newData.isString() && newData.val().length == 7 && newData.val().beginsWith('#')"
          },
          "daire1": {
            ".validate": "newData.isString() && newData.val().length == 7 && newData.val().beginsWith('#')"
          },
          "daire2": {
            ".validate": "newData.isString() && newData.val().length == 7 && newData.val().beginsWith('#')"
          },
          "daireGoster": {
            ".validate": "newData.isBoolean()"
          },
          "baslik": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "yaziTipi": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "emoji": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "emojiSayisi": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30"
          },
          "fotoHareket": {
            ".validate": "newData.isBoolean()"
          },
          "hizlar": {
            "$f": {
              ".validate": "($f == 'f0' || $f == 'f1' || $f == 'f2' || $f == 'f3' || $f == 'f4' || $f == 'f5' || $f == 'arka') && newData.isNumber() && newData.val() >= 0.25 && newData.val() <= 4"
            }
          },
          "$diger": {
            ".validate": false
          }
        },
        "muzik": {
          ".write": true,
          "simdiki": {
            ".validate": "newData.hasChildren(['baslik', 'baslangic', 'duraklatildi']) && (newData.hasChild('videoId') || newData.hasChild('arama'))",
            "videoId": {
              ".validate": "newData.isString() && newData.val().length == 11"
            },
            "baslik": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "kanal": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "ekleyen": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "baslangic": {
              ".validate": "newData.isNumber()"
            },
            "duraklatildi": {
              ".validate": "newData.isBoolean()"
            },
            "konum": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "arama": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "$diger": {
              ".validate": false
            }
          },
          "sira": {
            "$id": {
              ".validate": "newData.hasChild('baslik') && (newData.hasChild('videoId') || newData.hasChild('arama'))",
              "videoId": {
                ".validate": "newData.isString() && newData.val().length == 11"
              },
              "baslik": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "kanal": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "ekleyen": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "arama": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
              },
              "$diger": {
                ".validate": false
              }
            }
          },
          "onceki": {
            "$i": {
              ".validate": "newData.hasChildren(['videoId', 'baslik'])",
              "videoId": {
                ".validate": "newData.isString() && newData.val().length == 11"
              },
              "baslik": {
                ".validate": "newData.isString() && newData.val().length <= 200"
              },
              "kanal": {
                ".validate": "newData.isString() && newData.val().length <= 100"
              },
              "ekleyen": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$diger": {
                ".validate": false
              }
            }
          },
          "kutlama": {
            ".validate": "newData.isNumber()"
          },
          "radyoIcin": {
            ".validate": "newData.isString() && newData.val().length <= 220"
          },
          "radyoKapali": {
            ".validate": "newData.isBoolean()"
          },
          "sonAyrilma": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$diger": {
            ".validate": false
          }
        },
        "katilanlar": {
          ".write": true,
          "$id": {
            ".validate": "(newData.isString() && newData.val().length <= 40) || newData.hasChild('ad')",
            "ad": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "foto": {
              ".validate": "newData.isString() && (newData.val() == '' || (newData.val().beginsWith('https://lh') && newData.val().contains('.googleusercontent.com/') && newData.val().length <= 500))"
            },
            "zaman": {
              ".validate": "newData.val() == now"
            },
            "cikar": {
              ".validate": "newData.isBoolean() && auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))"
            },
            "tasi": {
              ".validate": "newData.isString() && newData.val().length <= 60 && root.child('odalar').child(newData.val()).exists() && auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))"
            },
            "$diger": {
              ".validate": false
            }
          }
        },
        "$diger": {
          ".validate": false
        }
      }
    },
    "odaFotolari": {
      ".read": true,
      "$oda": {
        ".write": "auth != null && ((root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com')) || (!root.child('yasakli').child(auth.uid).exists() && (root.child('odalar').child($oda).child('bilgi/sahip').val() == auth.uid || newData.parent().parent().child('odalar').child($oda).child('bilgi/sahip').val() == auth.uid)))",
        "$f": {
          ".validate": "($f == 'f0' || $f == 'f1' || $f == 'f2' || $f == 'f3' || $f == 'f4' || $f == 'f5' || $f == 'arka') && newData.isString() && ((newData.val().beginsWith('data:image/') && newData.val().length <= 400000) || (newData.val().beginsWith('data:video/') && newData.val().length <= 1500000))"
        }
      }
    },
    "odaGecmisi": {
      ".read": true,
      "$oda": {
        ".write": "auth != null && ((root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com')) || root.child('odalar').child($oda).child('bilgi/sahip').val() == auth.uid || newData.parent().parent().child('odalar').child($oda).child('bilgi/sahip').val() == auth.uid)",
        "$id": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['videoId', 'baslik', 'zaman'])",
          "videoId": {
            ".validate": "newData.isString() && newData.val().length == 11"
          },
          "baslik": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "kanal": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "ekleyen": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "zaman": {
            ".validate": "newData.isNumber()"
          },
          "$diger": {
            ".validate": false
          }
        }
      }
    },
    "kullanicilar": {
      ".read": "auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))",
      ".write": "auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "ad": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "foto": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "eposta": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "sonGiris": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.isNumber()"
        },
        "slot1": {
          ".write": "auth != null && auth.uid == $uid && !root.child('yasakli').child(auth.uid).exists() && (!data.exists() || newData.val() == data.val() || !newData.parent().parent().parent().child('odalar').child(data.val()).child('bilgi').exists())",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "slot2": {
          ".write": "auth != null && auth.uid == $uid && !root.child('yasakli').child(auth.uid).exists() && (!data.exists() || newData.val() == data.val() || !newData.parent().parent().parent().child('odalar').child(data.val()).child('bilgi').exists())",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "listeler": {
          ".write": "auth != null && auth.uid == $uid",
          "$liste": {
            ".validate": "newData.hasChildren(['ad'])",
            "ad": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            },
            "olusturma": {
              ".validate": "newData.isNumber()"
            },
            "sarkilar": {
              "$s": {
                ".validate": "newData.hasChild('baslik') && (newData.hasChild('videoId') || newData.hasChild('arama'))",
                "videoId": {
                  ".validate": "newData.isString() && newData.val().length == 11"
                },
                "baslik": {
                  ".validate": "newData.isString() && newData.val().length <= 200"
                },
                "kanal": {
                  ".validate": "newData.isString() && newData.val().length <= 100"
                },
                "eklenme": {
                  ".validate": "newData.isNumber()"
                },
                "arama": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                },
                "$diger": {
                  ".validate": false
                }
              }
            },
            "$diger": {
              ".validate": false
            }
          }
        },
        "$diger": {
          ".validate": false
        }
      }
    },
    "aramaOnbellek": {
      ".read": true,
      "$k": {
        ".write": "auth != null && (!data.exists() || data.child('zaman').val() < now - 604800000)",
        ".validate": "$k.length <= 100 && newData.hasChildren(['zaman', 'sonuclar'])",
        "zaman": {
          ".validate": "newData.isNumber()"
        },
        "sonuclar": {
          "$i": {
            ".validate": "newData.hasChildren(['videoId', 'baslik'])",
            "videoId": {
              ".validate": "newData.isString() && newData.val().length == 11"
            },
            "baslik": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "kanal": {
              ".validate": "newData.isString() && newData.val().length <= 100"
            },
            "$diger": {
              ".validate": false
            }
          }
        },
        "$diger": {
          ".validate": false
        }
      }
    },
    "yasakli": {
      ".read": "auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))",
      ".write": "auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    "yoneticiler": {
      ".read": "auth != null",
      ".write": false,
      "$uid": {
        ".validate": "newData.isBoolean()"
      }
    },
    "eslesmeler": {
      ".read": true,
      "$k": {
        ".write": "auth != null && !data.exists()",
        ".validate": "$k.length <= 100 && newData.isString() && newData.val().length == 11"
      }
    },
    "aktifOturum": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['sekme', 'oda', 'zaman'])",
        "sekme": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "oda": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "zaman": {
          ".validate": "newData.val() == now"
        },
        "$diger": {
          ".validate": false
        }
      }
    },
    "ayarlar": {
      ".read": true,
      "akis": {
        ".write": "auth != null && (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com'))",
        ".validate": "newData.hasChildren(['adres', 'zaman'])",
        "adres": {
          ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/[a-z0-9-]+\\.trycloudflare\\.com$/)"
        },
        "zaman": {
          ".validate": "newData.val() == now"
        },
        "$diger": {
          ".validate": false
        }
      }
    },
    "istatistik": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid == $uid || (root.child('yoneticiler').child(auth.uid).val() == true || (auth.token.email_verified == true && auth.token.email.toLowerCase() == 'erayaksuhome@outlook.com')))",
        ".validate": "newData.hasChildren(['sitede', 'dinleme', 'guncelleme'])",
        "guncelleme": {
          ".validate": "newData.val() == now"
        },
        "sitede": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 125) || (data.exists() && newData.val() >= data.val() && newData.val() - data.val() <= (now - data.parent().child('guncelleme').val()) / 1000 + 5))"
        },
        "dinleme": {
          ".validate": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 125) || (data.exists() && newData.val() >= data.val() && newData.val() - data.val() <= (now - data.parent().child('guncelleme').val()) / 1000 + 5))"
        },
        "ad": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "foto": {
          ".validate": "newData.isString() && (newData.val() == '' || (newData.val().beginsWith('https://lh') && newData.val().contains('.googleusercontent.com/') && newData.val().length <= 500))"
        },
        "$diger": {
          ".validate": false
        }
      }
    }
  }
}
